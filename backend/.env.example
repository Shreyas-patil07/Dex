APP_NAME=Dex API
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://dex-list.vercel.app
TMDB_API_KEY=your_tmdb_api_key
FIREBASE_PROJECT_ID=dex-07
# Optional: set to the full JSON contents of your Firebase service-account file.
FIREBASE_SERVICE_ACCOUNT=
# Used when FIREBASE_SERVICE_ACCOUNT is empty.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Use Redis-backed storage when running multiple backend instances.
RATE_LIMIT_STORAGE_URI=memory://
